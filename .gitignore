# ============================================================
# 个人数据 / 敏感凭证（绝不提交）
# ============================================================
# GitHub PAT，等同密码
.github_token
# 个人收藏夹及其损坏备份
favorites.json
favorites.json.bak
# 个人下载目录偏好
config.json
# 崩溃日志（可能含本机路径）
crash.log

# ============================================================
# 打包产物（体积大、平台相关，通过 GitHub Releases 分发）
# ============================================================
# PyInstaller 中间产物与 V1.1.0 目录（37 MB）
build/
# 打包输出
dist/
# --onedir 模式的运行时依赖（20 MB）
_internal/
# 打包出的可执行文件（5 MB，Windows 专用）
ghfind.exe
# 发行版压缩包（13 MB，通过 GitHub Releases 分发）
ghfind-v*.zip
# Inno Setup / 打包输出（约 65 MB，通过 GitHub Releases 分发）
Output/

# ============================================================
# Python 运行缓存
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# 虚拟环境（本机专用，依赖版本因人而异）
# ============================================================
.venv/
venv/
env/

# ============================================================
# 编辑器 / 操作系统生成文件
# ============================================================
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
# 临时文件
# ============================================================
*.tmp
.openbitfun/
/.openbitfun/search/flashgrep-index/
