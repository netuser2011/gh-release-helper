# 统一编辑器行为，避免中文注释被写成乱码、行尾混进 CRLF
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.bat]
# 批处理在 Windows 记事本里要用 CRLF，否则部分系统上回车会错位
end_of_line = crlf

[Makefile]
indent_style = tab
